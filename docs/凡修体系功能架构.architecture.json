  "cards": [
    {
      "dot": "cyan",
      "title": "唯一执行协议",
      "items": [
        "Kernel 是唯一长期存活的执行实体",
        "调试、人工和正式作业统一提交普通 Python Cell",
        "interrupt 保留 namespace；restart 才替换 Kernel"
      ]
    },
    {
      "dot": "emerald",
      "title": "业务闭环",
      "items": [
        "作业自己判断准入、业务终态与 next_time",
        "行为树完成 observe → decide → act → verify → finish",
        "场景与 Shape 资产承载可复用的视觉和导航知识"
      ]
    },
    {
      "dot": "rose",
      "title": "安全边界",
      "items": [
        "动态状态层严格只读，不注入、不 Hook、不发送游戏命令",
        "真正的游戏操作只通过行为树调用 ADB",
        "工程 / AI 是 Scheduler 唯一运行权开关"
      ]
    }
