# ==========================================
# CodeYun .env 示例
# ==========================================
# 说明：
# 1. 复制本文件为 `.env` 后按需修改。
# 2. `.env` 可以只写你真正需要覆盖的项，不必把所有变量都填满。
# 3. `device_id` 不再从 `.env` 读取。
#    系统会自动为当前物理机器生成稳定的 device_id，
#    并持久化到机器级 identity 文件中；以后即使切换 DATA_DIR，也会尽量复用同一个 device_id。


# ==========================================
# 基础运行配置
# ==========================================

# 运行环境：development / production / test
CODEYUN_ENV=development

# 是否输出更多调试信息
CODEYUN_DEBUG=1

# 后端监听地址与端口
CODEYUN_BACKEND_HOST=0.0.0.0
CODEYUN_BACKEND_PORT=8000

# 是否启用 OpenAPI / docs
# 生产环境通常建议关闭
CODEYUN_ENABLE_DOCS=1


# ==========================================
# 数据与持久化
# ==========================================

# 主数据目录
# 默认会放到仓库外的数据工作区：
# D:\home\chenkunze\data\m2603codeyun\codepc_<本机名>
# 也可以显式配置到指定实例目录，例如：
# D:\home\chenkunze\data\m2603codeyun\codepc_mf
CODEYUN_DATA_DIR=D:\path\to\codeyun-data

# 数据工作区
# 仅在未设置 CODEYUN_DATA_DIR 时用于推导默认实例目录。
CODEYUN_DATA_WORKSPACE_DIR=D:\home\chenkunze\data\m2603codeyun

# 数据实例名
# 仅在未设置 CODEYUN_DATA_DIR 时用于推导默认实例目录。
# 写 mf 会解析为 codepc_mf。
CODEYUN_DATA_INSTANCE_NAME=mf

# 机器级 identity 目录
# 这里保存当前物理机器的稳定身份信息（不是业务数据）
# 不配置时，Windows 默认在：
# C:\Users\<用户名>\AppData\Local\CodeYun
CODEYUN_MACHINE_STATE_DIR=

# 数据库连接
# 不配置时，默认使用：
# sqlite:///<CODEYUN_DATA_DIR>/codeyun.db
# 如需单独指定数据库，可填 sqlite:///... 或 postgresql://...
CODEYUN_DATABASE_URL=

# 资源备份/回收站存储治理
# 后台存储清理任务会在数据工作区总占用超过该上限时，优先永久清理旧回收站资源。
# 可写 10GB / 512MB / 1099511627776 这类格式；0 表示不按空间上限清理。
CODEYUN_RESOURCE_BACKUP_MAX_STORAGE_SIZE=10GB

# 是否允许自动清理旧回收站资源。
CODEYUN_RESOURCE_BACKUP_CLEANUP_ENABLED=1

# 回收站宽限期；刚删除的资源不会被自动永久清理。
CODEYUN_RESOURCE_BACKUP_TRASH_GRACE_DAYS=1

# SQLite 下永久清理后是否自动 VACUUM，以便真正回收数据库文件空间。
CODEYUN_RESOURCE_BACKUP_VACUUM_SQLITE=1


# ==========================================
# 安全与用户认证
# ==========================================

# JWT / 应用密钥
# 生产环境必须改成足够随机的长字符串
CODEYUN_SECRET_KEY=change-me-to-a-secure-random-string

# JWT 算法
CODEYUN_JWT_ALGORITHM=HS256

# Access Token 有效期（分钟）
# 默认 30 天 = 43200 分钟
CODEYUN_ACCESS_TOKEN_EXPIRE_MINUTES=43200


# ==========================================
# 设备面控制（集群 / 任务 / 设备控制）
# ==========================================

# 设备控制令牌
# 为空表示关闭设备面接口：
# - /api/task/*
# - /api/device-control/*
# - /api/fs/*
# 以及相关集群管理能力
CODEYUN_DEVICE_TOKEN=change-me-to-a-long-random-token


# ==========================================
# 启动期超管引导
# ==========================================

# 启动时确保存在的超管账号
# 只有用户名和密码都设置时才会生效
CODEYUN_BOOTSTRAP_ADMIN_USERNAME=admin
CODEYUN_BOOTSTRAP_ADMIN_PASSWORD=change-me

# 是否强制把上面的超管密码重置为当前值
# 0 = 不重置
# 1 = 强制重置
CODEYUN_BOOTSTRAP_ADMIN_FORCE_RESET_PASSWORD=0


# ==========================================
# CORS
# ==========================================

# 显式允许的前端来源，多个值用逗号分隔
# 例如：
# http://localhost:5173,http://192.168.31.63:5173
CODEYUN_CORS_ORIGINS=


# ==========================================
# 本地 AI 聊天（Ollama）
# ==========================================

# 默认 AI 来源
# 可选：ollama / deepseek
CODEYUN_AI_DEFAULT_PROVIDER=deepseek

# 本地 Ollama 服务地址
CODEYUN_OLLAMA_BASE_URL=http://127.0.0.1:11434

# AI 聊天页面默认模型
CODEYUN_OLLAMA_DEFAULT_MODEL=qwen3-vl:4b

# 请求 Ollama 的超时时间（秒）
CODEYUN_OLLAMA_TIMEOUT_SECONDS=120


# ==========================================
# AI 聊天（DeepSeek）
# ==========================================

# DeepSeek OpenAI-Compatible API 地址
CODEYUN_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek API Key
# 建议只写在本机 .env，不要提交到仓库
CODEYUN_DEEPSEEK_API_KEY=

# AI 聊天页面默认模型
CODEYUN_DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash

# 前端模型下拉的候选列表
CODEYUN_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-chat,deepseek-reasoner

# 请求 DeepSeek 的超时时间（秒）
CODEYUN_DEEPSEEK_TIMEOUT_SECONDS=120


# ==========================================
# OCR 服务
# ==========================================

# OCR 依赖安装 profile：
# - mi15 / CUDA 11.8：uv sync --group ocr-cu118
# - mf / CUDA 12.9：uv sync --group ocr-cu129
# - 纯 CPU 兜底：uv sync --group ocr-cpu
# 注意：CODEYUN_OCR_DEVICE 只决定运行时请求 gpu/cpu；
# 实际是否可用 GPU 取决于当前 venv 是否安装了对应 profile 的 paddlepaddle-gpu。

# OCR 默认运行设备。全局统一入口，凡修行为树也跟随该配置。
# 默认 gpu；没有可用 GPU 时 PaddleOCR 会自行回退 CPU。
CODEYUN_OCR_DEVICE=gpu

# 独立 OCR daemon 监听地址。通常不需要改，主后端 8000 会代理调用该服务。
CODEYUN_OCR_SERVICE_HOST=127.0.0.1
CODEYUN_OCR_SERVICE_PORT=8765

# 旧 pyxllib 客户端读取的 OCR 请求超时/重试配置。
# CodeYun 启动凡修行为树时会把这些值注入给子进程。
XL_API_PRIU_TIMEOUT=60
XL_API_PRIU_RETRIES=2
XL_API_PRIU_RETRY_INTERVAL=1


# ==========================================
# 项目内旧脚本 / 运维辅助配置
# ==========================================
# 下面这些不是 CodeYun 后端运行必需项，
# 主要给仓库里某些旧脚本、手动运维工具、个人辅助工具使用。

# 服务器连接信息
YUN_SERVER_HOST=1.2.3.4
YUN_SERVER_USER=deploy
YUN_SERVER_PASS=change-me
YUN_SERVER_PORT=22

# DSP 计算器源码路径（供个别脚本使用）
DSP_SOURCE_DIR=D:\path\to\dsp-calc
